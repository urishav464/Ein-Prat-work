# העתיקו לקובץ .streamlit/secrets.toml ומלאו.
# הקובץ האמיתי לא נכנס ל-git — ראו .gitignore.

# מפתח ה-API לצ'אט. בלעדיו כל שאר האפליקציה עובדת, והצ'אט מציג הודעה מסודרת.
ANTHROPIC_API_KEY = "sk-ant-..."

# מי מקבל הרשאות מדריך. כל השאר נכנסים כחניכים לפי השיוך בלוח הבקרה.
admin_emails = ["urishav464@gmail.com"]

# התחברות Google. כל עוד הבלוק הזה חסר — האפליקציה נופלת חזרה
# להזדהות בשם בלבד, שמתאימה לפיתוח מקומי ולא לפריסה.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "החליפו-במחרוזת-אקראית-ארוכה"
client_id = "...apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
