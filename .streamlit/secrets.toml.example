# העתיקו לקובץ .streamlit/secrets.toml, או הדביקו ב-Streamlit Cloud תחת
# Settings → Secrets. הקובץ האמיתי לא נכנס לגיט — ראו .gitignore.
#
# ⚠️ אין קובץ .env ואין מסד נתונים מקומי. הכל דרך Streamlit Secrets.

# --- אחסון: Supabase ---
# Supabase → Project Settings → API. השתמשו במפתח service_role: Streamlit רץ
# בצד השרת, כך שהדפדפן של החניך לא רואה אותו לעולם.
# ⚠️ מי שמשיג את המפתח מקבל את כל הנתונים. לא לגיט, לא לצ'אט, רק כאן.
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_KEY = "eyJhbGciOi..."

# --- הצ'אט ---
# בלי המפתח הזה כל שאר האפליקציה עובדת והצ'אט מציג הודעה מסודרת.
ANTHROPIC_API_KEY = "sk-ant-..."

# --- מי מקבל הרשאות מדריך ---
admin_emails = ["urishav464@gmail.com"]

# --- התחברות Google ---
# כל עוד הבלוק הזה חסר, ההזדהות היא בשם בלבד — מתאים לבדיקה, לא לחניכים.
[auth]
redirect_uri = "https://<שם-האפליקציה>.streamlit.app/oauth2callback"
cookie_secret = "החליפו-במחרוזת-אקראית-ארוכה"
client_id = "...apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
