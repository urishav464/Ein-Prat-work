// Cloudflare (Workers Builds) serves the site from here: `npm run build`
// writes dist/, then `npx wrangler deploy` publishes it as static files — no
// Worker code at all. The name must match the project's name in Cloudflare.
{
  "name": "mishmar-ein-prat",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // one page: any path the browser asks for gets index.html
    "not_found_handling": "single-page-application"
  },
  // the site's one address: https://mishmar-ein-prat.<account>.workers.dev
  "workers_dev": true,
  // no extra public address per uploaded version — one site, one address
  "preview_urls": false
}
